# ------------------------------------------------------------------
# الموقع يعمل بالكامل بلا أي من هذه المتغيرات:
# بلا Sanity  → يقرأ المحتوى التجريبي
# بلا Resend  → يتخطى البريد ويسجّل تحذيراً
# بلا Meta    → يتحوّل تلقائياً لزر wa.me بدل الإرسال التلقائي
# لا شيء منها يكسر البناء (SPEC §14)
# ------------------------------------------------------------------

# الدومين المطلق — مطلوب للـ canonical و hreflang وصور المشاركة
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# قراءة المسودات في المعاينة
SANITY_API_READ_TOKEN=
# كتابة وثائق التسجيل والرسائل — خادمي فقط، لا يُسبق بـ NEXT_PUBLIC_
SANITY_API_WRITE_TOKEN=
# سرّ مشترك لتوقيع webhook إبطال الكاش
SANITY_REVALIDATE_SECRET=

# --- البريد (Resend) ---
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_FROM=

# --- WhatsApp Cloud API (Meta) ---
# القوالب يجب أن تكون معتمدة من Meta قبل التفعيل — الاعتماد قد يستغرق أياماً
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_AR=registration_confirmation_ar
WHATSAPP_TEMPLATE_EN=registration_confirmation_en
